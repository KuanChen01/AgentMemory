# DeepSeek API Configuration
# Get your API key from https://platform.deepseek.com
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# DeepSeek Chat V4 API endpoint (defaults to standard OpenRouter or official DeepSeek API)
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# AgentVault Local Server Configuration
AGENTVAULT_PORT=38888

# Local Database Location (defaults to ~/.agentvault/agentvault.db)
# AGENTVAULT_DB_PATH=C:/Users/YourName/.agentvault/agentvault.db
