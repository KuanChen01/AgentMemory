# AgentMemory API Configuration
AGENTMEM_LLM_API_KEY=fill-me
AGENTMEM_LLM_API_URL=https://api.deepseek.com/v1
AGENTMEM_LLM_MODEL=deepseek-chat

# Optional: disable JSON mode for proxy providers that do not support it
AGENTMEM_LLM_DISABLE_JSON_MODE=false

# Memory extraction uses non-thinking mode on the official DeepSeek endpoint.
# Optional custom output budgets, OFF by default (use the model's own limits).
# Manage these values in the admin workbench LLM Settings panel.
AGENTMEM_OUTPUT_BUDGET_ENABLED=false
AGENTMEM_OBSERVATION_MAX_TOKENS=1024
AGENTMEM_DIGEST_MAX_TOKENS=3072
# Bound raw logs while retaining their beginning and final results.
AGENTMEM_TOOL_INPUT_MAX_CHARS=10000
AGENTMEM_TOOL_OUTPUT_MAX_CHARS=20000

# Optional: custom JSON headers for gateway-specific auth
# AGENTMEM_LLM_HEADERS={"X-Custom-Auth":"value"}

# Local worker port
AGENTMEM_PORT=38888
